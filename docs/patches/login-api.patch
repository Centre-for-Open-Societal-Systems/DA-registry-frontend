+import { describe, expect, it } from "vitest";
+import { toLoginResult, toPortalRole } from "./login";
+
+describe("toLoginResult", () => {
+  it("reads the login response", () => {
+    const res = {
+      data: { access_token: "a", expires_in: 900, refresh_token: "r", token_type: "Bearer", roles: ["Development Agent"], user: "da@moa.et" },
+    };
+    expect(toLoginResult(res, 1000)).toEqual({
+      user: { id: "da@moa.et", name: "da@moa.et", email: "da@moa.et" },
+      role: "DA",
+      tokens: { accessToken: "a", refreshToken: "r", expiresAt: 901_000 },
+    });
+  });
+});
+
+describe("toPortalRole", () => {
+  it("picks the most senior portal role", () => {
+    expect(toPortalRole(["Development Agent", "Supervisor", "Executive", "Administrator"])).toBe("Admin");
+    expect(toPortalRole(["Supervisor", "Communications Officer"])).toBe("Supervisor");
+  });
+
+  it("falls back to DA when no portal role is held", () => {
+    expect(toPortalRole(["Sales User"])).toBe("DA");
+  });
+});
diff --git a/src/features/auth/login.ts b/src/features/auth/login.ts
new file mode 100644
index 0000000..46fae63
--- /dev/null
+++ b/src/features/auth/login.ts
@@ -0,0 +1,54 @@
+import { apiPost } from "@/lib/api";
+import type { Role } from "@/lib/rbac";
+
+/** Successful POST /api/v1/auth/login — and /auth/refresh, which answers in the same shape. */
+export interface LoginResponse {
+  data: {
+    access_token: string;
+    /** Seconds the access token stays valid. */
+    expires_in: number;
+    refresh_token: string;
+    token_type: string;
+    roles: string[];
+    /** Backend user id, e.g. "Administrator" or the user's email. */
+    user: string;
+  };
+}
+
+export interface LoginResult {
+  user: { id: string; name: string; email: string };
+  role: Role;
+  tokens: { accessToken: string; refreshToken: string; expiresAt: number };
+}
+
+// Role the portal falls back to when the account holds none of the portal's roles.
+const FALLBACK_ROLE: Role = "DA";
+
+/** POST /api/v1/auth/login. Wrong credentials come back as ApiError with status 401. */
+export async function login(usr: string, pwd: string, rememberMe: boolean): Promise<LoginResult> {
+  const res = await apiPost<LoginResponse>("/auth/login", { usr: usr.trim(), pwd, remember_me: rememberMe });
+  return toLoginResult(res, Date.now());
+}
+
+export function toLoginResult({ data }: LoginResponse, now: number): LoginResult {
+  return {
+    // The response carries only the user id, which is the email for every account except Administrator.
+    user: { id: data.user, name: data.user, email: data.user },
+    role: toPortalRole(data.roles),
+    tokens: { accessToken: data.access_token, refreshToken: data.refresh_token, expiresAt: now + data.expires_in * 1000 },
+  };
+}
+
+// An account can hold several backend roles (Administrator holds all of them), so the most senior one wins.
+const ROLE_PRIORITY: [Role, string[]][] = [
+  ["Admin", ["Administrator", "OAN Administrator", "System Manager"]],
+  ["Executive", ["Executive"]],
+  ["Supervisor", ["Supervisor"]],
+  ["CommsOfficer", ["Communications Officer"]],
+  ["DA", ["Development Agent"]],
+];
+
+export function toPortalRole(backendRoles: string[]): Role {
+  const held = new Set(backendRoles);
+  return ROLE_PRIORITY.find(([, names]) => names.some((n) => held.has(n)))?.[0] ?? FALLBACK_ROLE;
+}
