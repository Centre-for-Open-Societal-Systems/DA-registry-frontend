+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { useAuthStore } from "@/store/useAuthStore";
+import { authRequest, getAccessToken, refreshSession } from "./session";
+
+// Minimal in-memory Storage so the persisted store and logout's draft cleanup run under Node.
+class MemoryStorage implements Storage {
+  private map = new Map<string, string>();
+  get length() { return this.map.size; }
+  clear() { this.map.clear(); }
+  getItem(k: string) { return this.map.get(k) ?? null; }
+  key(i: number) { return [...this.map.keys()][i] ?? null; }
+  removeItem(k: string) { this.map.delete(k); }
+  setItem(k: string, v: string) { this.map.set(k, String(v)); }
+}
+
+const json = (status: number, body: unknown) => new Response(JSON.stringify(body), { status });
+const refreshed = (n: number) =>
+  json(200, { data: { access_token: `access-${n}`, expires_in: 900, refresh_token: `refresh-${n}`, token_type: "Bearer", roles: [], user: "u" } });
+
+const fetchMock = vi.fn<typeof fetch>();
+
+function signInWith(expiresAt: number) {
+  useAuthStore.getState().signIn({ id: "u", name: "u", email: "u" }, "Admin", { accessToken: "access-0", refreshToken: "refresh-0", expiresAt });
+}
+
+beforeEach(() => {
+  globalThis.sessionStorage = new MemoryStorage();
+  globalThis.localStorage = new MemoryStorage();
+  fetchMock.mockReset();
+  vi.stubGlobal("fetch", fetchMock);
+});
+
+describe("refreshSession", () => {
+  it("stores the rotated pair and spends the refresh token only once for concurrent callers", async () => {
+    signInWith(0);
+    fetchMock.mockResolvedValueOnce(refreshed(1));
+
+    const results = await Promise.all([refreshSession(), refreshSession(), getAccessToken()]);
+
+    expect(results).toEqual(["access-1", "access-1", "access-1"]);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(JSON.parse(fetchMock.mock.calls[0][1]!.body as string)).toEqual({ refresh_token: "refresh-0" });
+    expect(useAuthStore.getState().tokens?.refreshToken).toBe("refresh-1");
+  });
+
+  it("signs out when the backend rejects the refresh token", async () => {
+    signInWith(0);
+    fetchMock.mockResolvedValueOnce(json(401, { message: "Invalid refresh token" }));
+
+    await expect(refreshSession()).resolves.toBeNull();
+    expect(useAuthStore.getState().isAuthenticated).toBe(false);
+  });
+
+  it("keeps the session on a network error", async () => {
+    signInWith(0);
+    fetchMock.mockRejectedValueOnce(new TypeError("offline"));
+
+    await expect(refreshSession()).rejects.toMatchObject({ status: 0 });
+    expect(useAuthStore.getState().tokens?.refreshToken).toBe("refresh-0");
+  });
+});
+
+describe("authRequest", () => {
+  it("uses the stored token while it is fresh", async () => {
+    signInWith(Date.now() + 600_000);
+    fetchMock.mockResolvedValueOnce(json(200, { ok: true }));
+
+    await authRequest("/things");
+
+    expect(new Headers(fetchMock.mock.calls[0][1]!.headers).get("Authorization")).toBe("Bearer access-0");
+  });
+
+  it("refreshes and retries once after a 401", async () => {
+    signInWith(Date.now() + 600_000);
+    fetchMock.mockResolvedValueOnce(json(401, {})).mockResolvedValueOnce(refreshed(1)).mockResolvedValueOnce(json(200, { ok: true }));
+
+    await expect(authRequest("/things")).resolves.toEqual({ ok: true });
+    expect(new Headers(fetchMock.mock.calls[2][1]!.headers).get("Authorization")).toBe("Bearer access-1");
+  });
+});
diff --git a/src/features/auth/session.ts b/src/features/auth/session.ts
new file mode 100644
index 0000000..e02950b
--- /dev/null
+++ b/src/features/auth/session.ts
@@ -0,0 +1,59 @@
+import { ApiError, apiPost, apiRequest, type ApiRequest } from "@/lib/api";
+import { useAuthStore } from "@/store/useAuthStore";
+import { toLoginResult, type LoginResponse } from "./login";
+
+// Refresh this long before the access token's expiry, so a request never leaves with a token about to lapse.
+const EXPIRY_SKEW_MS = 30_000;
+
+// Refresh tokens are single-use: the backend rotates them and rejects a reused one with 401. Concurrent
+// callers therefore share one in-flight refresh instead of each spending the same token.
+let inflight: Promise<string | null> | null = null;
+
+/**
+ * POST /api/v1/auth/refresh and store the new token pair. Resolves to the new access token, or null when
+ * the session is over (no refresh token, or the backend rejected it) — the user is then signed out.
+ * Network and server errors are rethrown and keep the session, so a flaky connection does not log anyone out.
+ */
+export function refreshSession(): Promise<string | null> {
+  inflight ??= (async () => {
+    const refreshToken = useAuthStore.getState().tokens?.refreshToken;
+    if (!refreshToken) return null;
+    try {
+      const res = await apiPost<LoginResponse>("/auth/refresh", { refresh_token: refreshToken });
+      const { tokens } = toLoginResult(res, Date.now());
+      useAuthStore.getState().setTokens(tokens);
+      return tokens.accessToken;
+    } catch (err) {
+      if (err instanceof ApiError && (err.status === 400 || err.status === 401)) {
+        useAuthStore.getState().logout();
+        return null;
+      }
+      throw err;
+    }
+  })().finally(() => {
+    inflight = null;
+  });
+  return inflight;
+}
+
+/** A usable access token, refreshing first when the stored one has expired or is about to. */
+export async function getAccessToken(): Promise<string | null> {
+  const tokens = useAuthStore.getState().tokens;
+  if (!tokens) return null;
+  if (tokens.expiresAt - EXPIRY_SKEW_MS > Date.now()) return tokens.accessToken;
+  return refreshSession();
+}
+
+/** apiRequest for signed-in calls: attaches the Bearer token and retries once after a 401 with a fresh one. */
+export async function authRequest<T>(path: string, init: Omit<ApiRequest, "accessToken"> = {}): Promise<T> {
+  const accessToken = await getAccessToken();
+  if (!accessToken) throw new ApiError("Your session has ended. Please sign in again.", 401);
+  try {
+    return await apiRequest<T>(path, { ...init, accessToken });
+  } catch (err) {
+    if (!(err instanceof ApiError) || err.status !== 401) throw err;
+    const fresh = await refreshSession();
+    if (!fresh) throw err;
+    return apiRequest<T>(path, { ...init, accessToken: fresh });
+  }
+}
diff --git a/src/lib/api.ts b/src/lib/api.ts
new file mode 100644
index 0000000..c8958c9
--- /dev/null
+++ b/src/lib/api.ts
@@ -0,0 +1,49 @@
+// Thin fetch wrapper for the backend. Requests go to this app's /api/v1, which next.config proxies to the
+// backend, so the browser never makes a cross-origin call.
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    /** HTTP status; 0 when the request never reached the server. */
+    readonly status: number,
+  ) {
+    super(message);
+    this.name = "ApiError";
+  }
+}
+
+export interface ApiRequest {
+  method?: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
+  body?: unknown;
+  /** Sent as `Authorization: Bearer …`; signed-in calls get it from features/auth (authRequest). */
+  accessToken?: string;
+}
+
+export async function apiRequest<T>(path: string, { method = "GET", body, accessToken }: ApiRequest = {}): Promise<T> {
+  const headers: Record<string, string> = { Accept: "application/json" };
+  if (body !== undefined) headers["Content-Type"] = "application/json";
+  if (accessToken) headers.Authorization = `Bearer ${accessToken}`;
+
+  let res: Response;
+  try {
+    res = await fetch(`/api/v1${path}`, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
+  } catch {
+    throw new ApiError("Could not reach the server. Check your connection and try again.", 0);
+  }
+
+  const data = await res.json().catch(() => null);
+  if (!res.ok) throw new ApiError(errorMessage(data) ?? `Request failed (${res.status}).`, res.status);
+  return data as T;
+}
+
+export const apiPost = <T>(path: string, body: unknown) => apiRequest<T>(path, { method: "POST", body });
+
+// Error bodies carry their text under `message` (Frappe), `error` or `detail`; take the first readable one.
+function errorMessage(data: unknown): string | undefined {
+  if (!data || typeof data !== "object") return undefined;
+  const d = data as Record<string, unknown>;
+  for (const value of [d.message, d.error, d.detail]) {
+    if (typeof value === "string" && value.trim()) return value;
+  }
+  return undefined;
+}
